meta {
  name: List Communications
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/communications?entityType=Broker&entityId={{brokerId}}&page=1&pageSize=25
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.data: isDefined
  res.body.page: isDefined
  res.body.pageSize: isDefined
  res.body.totalCount: isDefined
}
